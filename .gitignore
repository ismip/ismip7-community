# Keep this list short. Git skips ignored files without a word, so a
# pattern that matches a folder name a contributor might use, such as lib/
# or env/, silently drops their files. Only list what is never part of a
# contribution.

# Credentials
.env
.envrc
.netrc

# Data: link to where it lives instead
*.nc
*.nc4
*.h5
*.hdf5
*.zarr/
*.grib
*.grib2
*.mat
*.npy
*.npz

# Python and Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# R
.Rhistory
.RData
.Rproj.user/

# MATLAB
*.asv

# Operating systems and editors
.DS_Store
Thumbs.db
*~
*.swp

# Claude Code
.claude/worktrees/
.claude/settings.local.json
